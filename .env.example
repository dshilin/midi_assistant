# LLM provider selection: "openai" (default) or "yandex" / "yandexgpt"
LLM_PROVIDER=openai

# OpenAI-compatible LLM (consultant)
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# YandexGPT (consultant) — used when LLM_PROVIDER=yandexgpt
YC_API_KEY=your_api_key_here
YC_FOLDER_ID=your_folder_id_here

# Telegram bot interface
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
